{
  "name": "fuflomycin-expo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build:list": "tsx scripts/build-list.ts",
    "prestart": "npm run build:list",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "npm run build:list",
    "build": "expo export --platform web",
    "eas-build-post-install": "npm run build:list",
    "typecheck": "npm run build:list && tsc --noEmit",
    "test": "tsx --test list-build/index.test.ts src/working-list/index.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  }
}
